{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "moduleResolution": "node",
        "noImplicitAny": false,
        "strict": false,
        "noEmitHelpers": true,
        "importHelpers": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "ignoreDeprecations": "6.0",
        "lib": ["DOM", "WebWorker", "ES2022"]
    }
}
